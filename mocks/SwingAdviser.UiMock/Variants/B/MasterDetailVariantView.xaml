<UserControl x:Class="SwingAdviser.UiMock.Variants.B.MasterDetailVariantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:SwingAdviser.UiMock.Shared"
             d:DesignHeight="700"
             d:DesignWidth="1300"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 左: セクションナビゲーション -->
        <StackPanel Grid.Row="0" Grid.Column="0">
            <Button Margin="0,0,0,4"
                    HorizontalContentAlignment="Left"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="Candidates"
                    Content="候補一覧" />
            <Button Margin="0,0,0,4"
                    HorizontalContentAlignment="Left"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="Positions"
                    Content="保有ポジション" />
            <Button HorizontalContentAlignment="Left"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="History"
                    Content="約定履歴" />
        </StackPanel>

        <!-- 候補: 一覧(左) + 詳細(右) の2ペイン -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SelectedSection}" Value="Candidates">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <Button Margin="0,0,0,8"
                        Click="RunAiCheckButton_Click"
                        Content="選択にAIチェックを実行"
                        DockPanel.Dock="Top" />
                <ListBox x:Name="CandidatesList"
                         ItemsSource="{Binding CandidateList.Candidates}"
                         SelectedItem="{Binding CandidateList.SelectedCandidate}"
                         SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding Code, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" Text="{Binding SideLabel, Mode=OneWay}" />
                                    <TextBlock Margin="0,0,8,0" Text="{Binding Score, Mode=OneWay, StringFormat=スコア{0}}" />
                                    <shared:SeverityBadge Severity="{Binding AiStateSeverity, Mode=OneWay}" Text="{Binding AiStateText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource DisclaimerTextStyle}" Text="{x:Static shared:MockLabels.ScoreCaption}" />
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding CandidateList.SelectedCandidate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource CandidateDetailTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CandidateList.SelectedCandidate}" Value="{x:Null}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CandidateDetailEmptyTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </ScrollViewer>
                <StackPanel Grid.Row="1"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CandidateList.CancelQueuedCommand}"
                            CommandParameter="{Binding CandidateList.SelectedCandidate}"
                            Content="待機中キャンセル" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding CandidateList.RetryCommand}"
                            CommandParameter="{Binding CandidateList.SelectedCandidate}"
                            Content="再試行" />
                    <Button Command="{Binding CandidateList.RequestManualEntryCommand}"
                            CommandParameter="{Binding CandidateList.SelectedCandidate}"
                            Content="候補から手動約定登録" />
                </StackPanel>
                <ScrollViewer Grid.Row="2"
                              MaxHeight="160"
                              Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding CandidateList.Exclusions}" ContentTemplate="{StaticResource ExclusionListTemplate}" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 保有 -->
        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SelectedSection}" Value="Positions">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ContentControl Content="{Binding PositionList.Positions}" ContentTemplate="{StaticResource PositionListTemplate}" />
        </ScrollViewer>

        <!-- 履歴 -->
        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SelectedSection}" Value="History">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ContentControl Content="{Binding TradeHistory.Executions}" ContentTemplate="{StaticResource TradeHistoryTemplate}" />
        </ScrollViewer>

        <!-- フッター: 状態 -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,8,0,0"
                Padding="8"
                Background="{DynamicResource MahApps.Brushes.Gray9}">
            <ContentControl Content="{Binding State}" ContentTemplate="{StaticResource DualProgressTemplate}" />
        </Border>
    </Grid>
</UserControl>
