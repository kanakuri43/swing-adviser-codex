<UserControl x:Class="SwingAdviser.UiMock.Variants.C.DashboardVariantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:SwingAdviser.UiMock.Shared"
             xmlns:vm="clr-namespace:SwingAdviser.UiMock.ViewModels"
             d:DesignHeight="700"
             d:DesignWidth="1300"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <Style x:Key="TileStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <DataTemplate x:Key="CandidateCardTemplate" DataType="{x:Type vm:CandidateRowViewModel}">
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding Code, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding Name, Mode=OneWay}" />
                            <Run Text=" ／ " />
                            <Run Text="{Binding SideLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding EvaluationBarDateLabel, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="{Binding AnalyzedAtLabel, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldValueTextStyle}" Text="{Binding PrimaryReason, Mode=OneWay}" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" FontWeight="Bold" Text="{Binding Score, Mode=OneWay}" />
                            <TextBlock Margin="0,0,8,0" Text="{Binding ConfidenceLabel, Mode=OneWay, StringFormat=信頼度 {0}}" />
                            <TextBlock Text="{Binding AiAlignmentText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsShortCandidate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}" Text="売建可否: " />
                            <shared:SeverityBadge Severity="{Binding ShortAvailabilitySeverity, Mode=OneWay}" Text="{Binding ShortAvailabilityText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <shared:SeverityBadge Margin="0,0,0,4"
                                              HorizontalAlignment="Right"
                                              Severity="{Binding AiStateSeverity, Mode=OneWay}"
                                              Text="{Binding AiStateText, Mode=OneWay}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,4,0"
                                    Command="{Binding DataContext.CandidateList.CancelQueuedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="待機中キャンセル"
                                    FontSize="11" />
                            <Button Margin="0,0,4,0"
                                    Command="{Binding DataContext.CandidateList.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="再試行"
                                    FontSize="11" />
                            <Button Command="{Binding DataContext.CandidateList.RequestManualEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="候補から登録"
                                    FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- サマリタイル -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12" Orientation="Horizontal">
            <Button Command="{Binding State.StartDailyUpdateCommand}" Style="{StaticResource TileStyle}" ToolTip="クリックで模擬日次更新を開始">
                <TextBlock Text="{Binding State.DailyUpdate.StatusText}" TextWrapping="Wrap" />
            </Button>
            <Button Command="{Binding SelectSectionCommand}" CommandParameter="Candidates" Style="{StaticResource TileStyle}">
                <TextBlock Text="{Binding State.AiQueue.StatusText}" TextWrapping="Wrap" />
            </Button>
            <Button Command="{Binding SelectSectionCommand}" CommandParameter="Candidates" Style="{StaticResource TileStyle}">
                <TextBlock Text="{Binding State.LongCandidateCount, StringFormat=Long候補 {0}}" />
            </Button>
            <Button Command="{Binding SelectSectionCommand}" CommandParameter="Candidates" Style="{StaticResource TileStyle}">
                <TextBlock Text="{Binding State.ShortCandidateCount, StringFormat=Short候補 {0}}" />
            </Button>
            <Button Command="{Binding SelectSectionCommand}" CommandParameter="Positions" Style="{StaticResource TileStyle}">
                <TextBlock Text="{Binding State.PositionCount, StringFormat=保有 {0}}" />
            </Button>
            <Button Command="{Binding SelectSectionCommand}" CommandParameter="Positions" Style="{StaticResource TileStyle}">
                <TextBlock Text="{Binding State.ReconciliationRequiredCount, StringFormat=要照合 {0}}" />
            </Button>
            <Button Command="{Binding SelectSectionCommand}" CommandParameter="Positions" Style="{StaticResource TileStyle}">
                <TextBlock Text="{Binding State.DeadlineApproachingCount, StringFormat=期限接近 {0}}" />
            </Button>
        </StackPanel>

        <!-- 候補 -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SelectedSection}" Value="Candidates">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                <Button x:Name="RunAiCheckButton"
                        Margin="0,0,8,0"
                        Click="RunAiCheckButton_Click"
                        Content="選択にAIチェックを実行" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource DisclaimerTextStyle}" Text="{x:Static shared:MockLabels.ScoreCaption}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ListBox x:Name="CandidatesList"
                             BorderThickness="0"
                             ItemTemplate="{StaticResource CandidateCardTemplate}"
                             ItemsSource="{Binding CandidateList.Candidates}"
                             SelectionMode="Extended" />
                    <ContentControl Content="{Binding CandidateList.Exclusions}" ContentTemplate="{StaticResource ExclusionListTemplate}" />
                    <TextBlock Style="{StaticResource CollapseWhenTextNullStyle}" Text="{Binding State.EmptyStateNote}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 保有 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SelectedSection}" Value="Positions">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ContentControl Content="{Binding PositionList.Positions}" ContentTemplate="{StaticResource PositionListTemplate}" />
        </ScrollViewer>

        <!-- 履歴 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SelectedSection}" Value="History">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ContentControl Content="{Binding TradeHistory.Executions}" ContentTemplate="{StaticResource TradeHistoryTemplate}" />
        </ScrollViewer>
    </Grid>
</UserControl>
