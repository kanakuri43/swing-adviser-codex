<UserControl x:Class="SwingAdviser.UiMock.Variants.A.TabbedVariantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:SwingAdviser.UiMock.Shared"
             xmlns:vm="clr-namespace:SwingAdviser.UiMock.ViewModels"
             d:DesignHeight="700"
             d:DesignWidth="1300"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 上部タブ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Margin="0,0,4,0" Command="{Binding SelectSectionCommand}" CommandParameter="Candidates" Content="候補" />
            <Button Margin="0,0,4,0" Command="{Binding SelectSectionCommand}" CommandParameter="Positions" Content="保有" />
            <Button Command="{Binding SelectSectionCommand}" CommandParameter="History" Content="履歴" />
        </StackPanel>

        <!-- グローバル更新/AI状態ストリップ -->
        <Border Grid.Row="1"
                Margin="0,8,0,8"
                Padding="8"
                Background="{DynamicResource MahApps.Brushes.Gray9}">
            <ContentControl Content="{Binding State}" ContentTemplate="{StaticResource DualProgressTemplate}" />
        </Border>

        <!-- 候補セクション -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SelectedSection}" Value="Candidates">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="CandidatesGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      FrozenColumnCount="3"
                      IsReadOnly="True"
                      ItemsSource="{Binding CandidateList.Candidates}"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="コード" />
                    <DataGridTextColumn Width="140" Binding="{Binding Name}" Header="銘柄名" />
                    <DataGridTextColumn Width="90" Binding="{Binding SideLabel}" Header="Long/Short" />
                    <DataGridTemplateColumn Width="50" Header="種別">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="Entry" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="110" Binding="{Binding EvaluationBarDateText}" Header="判定基準バー日" />
                    <DataGridTextColumn Width="150" Binding="{Binding AnalyzedAtText}" Header="分析実行日時" />
                    <DataGridTextColumn Width="140" Binding="{Binding StrategyLabel}" Header="適用戦略" />
                    <DataGridTextColumn Width="50" Binding="{Binding Score}" Header="スコア" />
                    <DataGridTextColumn Width="60" Binding="{Binding ConfidenceLabel}" Header="信頼度" />
                    <DataGridTextColumn Width="220" Binding="{Binding PrimaryReason}" Header="主な判定理由" />
                    <DataGridTemplateColumn Width="150" Header="AI状態">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CandidateRowViewModel}">
                                <shared:SeverityBadge Severity="{Binding AiStateSeverity}" Text="{Binding AiStateText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="160" Binding="{Binding AiAlignmentText}" Header="AI整合" />
                    <DataGridTemplateColumn Width="180" Header="売建可否">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CandidateRowViewModel}">
                                <shared:SeverityBadge Severity="{Binding ShortAvailabilitySeverity}" Text="{Binding ShortAvailabilityText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="220" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CandidateRowViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Margin="0,0,4,0"
                                            Command="{Binding DataContext.CandidateList.CancelQueuedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="待機中キャンセル" />
                                    <Button Margin="0,0,4,0"
                                            Command="{Binding DataContext.CandidateList.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="再試行" />
                                    <Button Command="{Binding DataContext.CandidateList.RequestManualEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="候補から登録" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Click="RunAiCheckButton_Click"
                            Content="選択した候補にAIチェックを実行" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource DisclaimerTextStyle}" Text="{x:Static shared:MockLabels.ScoreCaption}" />
                </StackPanel>
                <ContentControl Margin="0,8,0,0" Content="{Binding CandidateList.Exclusions}" ContentTemplate="{StaticResource ExclusionListTemplate}" />
                <TextBlock Style="{StaticResource CollapseWhenTextNullStyle}" Text="{Binding State.EmptyStateNote}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- 保有セクション -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SelectedSection}" Value="Positions">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ContentControl Content="{Binding PositionList.Positions}" ContentTemplate="{StaticResource PositionListTemplate}" />
        </ScrollViewer>

        <!-- 履歴セクション -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SelectedSection}" Value="History">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ContentControl Content="{Binding TradeHistory.Executions}" ContentTemplate="{StaticResource TradeHistoryTemplate}" />
        </ScrollViewer>
    </Grid>
</UserControl>
