<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mock="clr-namespace:SwingAdviser.UiMock.Mock"
                    xmlns:shared="clr-namespace:SwingAdviser.UiMock.Shared"
                    xmlns:vm="clr-namespace:SwingAdviser.UiMock.ViewModels">

    <ResourceDictionary.MergedDictionaries>
        <!-- StaticResourceは自身のファイル単位で解決されるため、他ファイルのキー（FieldLabelTextStyle等）を
             使うには明示的にここでも取り込む必要がある。App.xaml側の並び順だけでは解決できない。 -->
        <ResourceDictionary Source="MockStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        候補明細・除外一覧・進捗表示は3案共通のテンプレートとする。
        ラベル・警告色の規則が案ごとにブレないようにするための境界。
    -->

    <DataTemplate x:Key="CandidateDetailTemplate" DataType="{x:Type vm:CandidateRowViewModel}">
        <StackPanel MaxWidth="480">
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}">
                <Run Text="{Binding Code, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding Name, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Style="{StaticResource FieldValueTextStyle}" Text="{Binding SideLabel, Mode=OneWay}" />
            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="{Binding EvaluationBarDateLabel, Mode=OneWay}" />
            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="{Binding AnalyzedAtLabel, Mode=OneWay}" />
            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="{Binding StrategyLabel, Mode=OneWay}" />

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding Score, Mode=OneWay}" />
                <TextBlock Margin="6,8,0,0" Text="{Binding ConfidenceLabel, Mode=OneWay, StringFormat=信頼度: {0}}" />
            </StackPanel>
            <TextBlock Style="{StaticResource DisclaimerTextStyle}" Text="{x:Static shared:MockLabels.ScoreCaption}" />

            <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabelTextStyle}" Text="主な判定理由" />
            <TextBlock Style="{StaticResource FieldValueTextStyle}" Text="{Binding PrimaryReason, Mode=OneWay}" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}" Text="AI状態: " />
                <shared:SeverityBadge Severity="{Binding AiStateSeverity, Mode=OneWay}" Text="{Binding AiStateText, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource FieldValueTextStyle}" Text="{Binding AiAlignmentText, Mode=OneWay}" />

            <StackPanel Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding IsShortCandidate, Converter={StaticResource BoolToVisibility}}">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}" Text="売建可否: " />
                <shared:SeverityBadge Severity="{Binding ShortAvailabilitySeverity, Mode=OneWay}" Text="{Binding ShortAvailabilityText, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabelTextStyle}" Text="AI試行履歴" />
            <ItemsControl ItemsSource="{Binding AttemptLog, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="12" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CandidateDetailEmptyTemplate">
        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="左の一覧（または表内の行）から候補を選択すると、ここに明細が表示されます。" TextWrapping="Wrap" />
    </DataTemplate>

    <DataTemplate x:Key="ExclusionRowTemplate" DataType="{x:Type vm:ExclusionRowViewModel}">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Code, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabelTextStyle}" Text="{Binding ReasonText, Mode=OneWay}" TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExclusionListTemplate">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="スキャン対象外（除外理由）" />
            <ItemsControl ItemTemplate="{StaticResource ExclusionRowTemplate}" ItemsSource="{Binding}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DualProgressTemplate" DataType="{x:Type mock:MockScenarioState}">
        <StackPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,16,0">
                <TextBlock FontWeight="SemiBold" Text="日次更新" />
                <TextBlock Text="{Binding DailyUpdate.StatusText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock FontWeight="SemiBold" Text="AIキュー" />
                <TextBlock Text="{Binding AiQueue.StatusText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel>
                <Button Margin="0,0,0,2"
                        Command="{Binding StartDailyUpdateCommand}"
                        Content="模擬日次更新を開始" />
                <Button Command="{Binding CompleteNowCommand}" Content="即時完了" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
