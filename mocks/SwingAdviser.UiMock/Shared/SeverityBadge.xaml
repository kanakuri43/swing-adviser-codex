<UserControl x:Class="SwingAdviser.UiMock.Shared.SeverityBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Left"
             VerticalAlignment="Center">
    <Border x:Name="Badge"
            Padding="8,2"
            CornerRadius="10">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray6}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Positive">
                        <Setter Property="Background" Value="#2E7D32" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Neutral">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Caution">
                        <Setter Property="Background" Value="#B8860B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Warning">
                        <Setter Property="Background" Value="#C56A00" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Critical">
                        <Setter Property="Background" Value="#B00020" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Muted">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock x:Name="Label"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Text="{Binding Text, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="White" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Muted">
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray1}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Border>
</UserControl>
