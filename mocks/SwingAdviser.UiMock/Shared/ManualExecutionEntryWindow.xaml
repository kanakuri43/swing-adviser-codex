<mah:MetroWindow x:Class="SwingAdviser.UiMock.Shared.ManualExecutionEntryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="手動約定登録"
                 Width="480"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner">
    <mah:MetroWindow.Resources>
        <Style x:Key="EditPanelStyle" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConfirming}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </mah:MetroWindow.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 入力パネル -->
        <StackPanel x:Name="EditPanel"
                    Grid.Row="0"
                    Style="{StaticResource EditPanelStyle}">
            <TextBlock Margin="0,0,0,12" Style="{StaticResource DisclaimerTextStyle}" Text="{Binding ManualEntryHeader}" TextWrapping="Wrap" />

            <Border Style="{StaticResource ReadOnlyPrefillBandStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="{Binding PrefillNote}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding PrefillHeaderText}" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,12,0,4" Text="種別" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="OpenKindRadio"
                             Margin="0,0,16,0"
                             Checked="OpenKindRadio_Checked"
                             Content="新規建"
                             GroupName="Kind"
                             IsChecked="True" />
                <RadioButton x:Name="CloseKindRadio"
                             Checked="CloseKindRadio_Checked"
                             Content="決済"
                             GroupName="Kind" />
            </StackPanel>

            <TextBlock Margin="0,12,0,4" Text="約定日時" />
            <StackPanel Orientation="Horizontal">
                <DatePicker Width="140" SelectedDate="{Binding ExecutedAtDate}" />
                <TextBox Width="100"
                         Margin="8,0,0,0"
                         mah:TextBoxHelper.Watermark="HH:mm:ss"
                         Text="{Binding ExecutedAtTime, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Margin="0,12,0,4" Text="約定価格" />
            <TextBox mah:TextBoxHelper.Watermark="{Binding PriceWatermark}" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,4" Text="株数" />
            <TextBox mah:TextBoxHelper.Watermark="証券会社の約定通知の株数を入力" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCloseKind, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="充当lot" />
                <ComboBox ItemsSource="{Binding AvailableLots}" SelectedItem="{Binding SelectedLot}" />
                <TextBlock Style="{StaticResource DisclaimerTextStyle}" Text="{Binding LotAllocationNote}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Margin="0,12,0,4" Text="手数料（任意）" />
            <TextBox Text="{Binding FeeText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,4" Text="メモ（任意）" />
            <TextBox AcceptsReturn="True" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />

            <TextBlock Margin="0,12,0,0"
                       Foreground="#B00020"
                       Style="{StaticResource CollapseWhenTextNullStyle}"
                       Text="{Binding ValidationMessage}"
                       TextWrapping="Wrap" />

            <Button Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding ConfirmCommand}"
                    Content="入力内容を確認" />
        </StackPanel>

        <!-- 確認パネル -->
        <StackPanel x:Name="ConfirmPanel"
                    Grid.Row="1"
                    Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Margin="0,12,0,12"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Text="入力内容の確認" />
            <TextBlock Text="{Binding ConfirmationSummary}" TextWrapping="Wrap" />
            <StackPanel Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,8,0" Command="{Binding BackToEditCommand}" Content="戻る" />
                <Button Command="{Binding RegisterCommand}" Content="上記の内容で登録する" />
            </StackPanel>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
